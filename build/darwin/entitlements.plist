<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the signed, notarized macOS build (hardened runtime).
  The app is not sandboxed, so file and network access need no entries.
-->
<plist version="1.0">
<dict>
    <!-- Voice input: the web view's speech recognition records from the microphone. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
